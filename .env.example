# ================================================
# DART x SAP x RCM Internal Control Review Agent
# 이 파일을 .env 로 복사한 뒤 값을 채워 넣으세요.
#   cp .env.example .env   (macOS/Linux)
#   copy .env.example .env (Windows)
# ================================================

# [필수] OpenDART API 인증키 (https://opendart.fss.or.kr → 인증키 신청)
DART_API_KEY=

# [선택] AI 검토의견 생성 provider: mock | claude | openai | gemini
# 키가 없으면 자동으로 mock(결정적 규칙 기반) 으로 동작합니다.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# [선택] provider별 모델 override
CLAUDE_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.0-flash

# [선택] Google Sheets 내보내기
# 서비스 계정 JSON 파일 경로 또는 JSON 문자열 자체
GOOGLE_SERVICE_ACCOUNT_JSON=
# 기록할 스프레드시트 ID (URL 의 /d/ 와 /edit 사이 문자열)
GOOGLE_SHEET_ID=
